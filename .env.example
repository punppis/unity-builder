# Unity
UNITY_PATH=/Applications/Unity/Hub/Editor/2022.3.0f1/Unity.app/Contents/MacOS/Unity
UNITY_PROJECT_PATH=/path/to/your/unity/project
UNITY_BUILD_METHOD_ANDROID=BuildScript.BuildAndroid
UNITY_BUILD_METHOD_IOS=BuildScript.BuildiOS

# Git
BUILDS_BRANCH=builds

# Build output
BUILD_OUTPUT_PATH=./build
ANDROID_OUTPUT_FILE=build/android/app.apk
ANDROID_AAB_OUTPUT_FILE=build/android/app.aab
IOS_OUTPUT_PATH=build/ios

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#builds

# SMB (for Android artifact upload)
SMB_HOST=your-smb-server
SMB_SHARE=builds
SMB_DOMAIN=WORKGROUP
SMB_USERNAME=smb_user
SMB_PASSWORD=smb_password
SMB_REMOTE_PATH=/Android

# Apple App Store Connect (for iOS TestFlight upload)
APPLE_KEY_ID=your-key-id
APPLE_ISSUER_ID=your-issuer-id
APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey_XXXX.p8
APPLE_BUNDLE_ID=com.yourcompany.yourapp

# Google Play (for AAB upload and signed APK download)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account.json
GOOGLE_PLAY_PACKAGE_NAME=com.yourcompany.yourapp
GOOGLE_PLAY_TRACK=internal
